# ── ShopHub Environment Variables ──────────────────────────────────────────
# Copy this file to .env and fill in your values

FLASK_ENV=development
DEBUG=True

# Change these before going to production!
SECRET_KEY=shophub-super-secret-key-change-me
JWT_SECRET_KEY=jwt-super-secret-key-change-me

# Swap for PostgreSQL/MySQL in production:
# DATABASE_URL=postgresql://user:password@localhost/shophub
DATABASE_URL=sqlite:///shophub.db

# Emotion detection confidence threshold (0.0 – 1.0)
EMOTION_CONFIDENCE_THRESHOLD=0.40
